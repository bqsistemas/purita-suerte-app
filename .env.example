# Environment variables for Purita Suerte MVP0
# Copy this file to .env and fill in values

# API Configuration
EXPO_PUBLIC_API_URL=https://api.puritasuerte.local

# Sentry (Error Tracking) - Optional for MVP0
EXPO_PUBLIC_SENTRY_DSN=

# Feature Flags - Optional for MVP0
EXPO_PUBLIC_FEATURE_FLAGS_ENABLED=false
